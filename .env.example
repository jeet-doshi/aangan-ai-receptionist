# Copy to .env.local and fill in what you have. Everything is optional:
# the app runs in clearly-labelled demo mode without any of these.
# Only NEXT_PUBLIC_ values are ever visible to the browser.

# --- Supabase (persistent storage). Project Settings -> API. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# SERVER ONLY (secret / service-role key). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# --- Telegram handoff. @BotFather -> /newbot gives the token; chat id from /getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: separate chat for urgent escalations (falls back to TELEGRAM_CHAT_ID)
TELEGRAM_ESCALATION_CHAT_ID=

# --- Vaani Voice post-call webhook. Any long random string; also configure it in Vaani.
VAANI_WEBHOOK_SECRET=

# --- Cost model (INR). Placeholders: replace with your actual Vaani plan rates.
VOICE_COST_PER_MIN_INR=4
AI_COST_PER_CALL_INR=1

# --- Optional: public URL used for record links inside Telegram messages
APP_BASE_URL=

# --- Password gate for the whole dashboard (any username). Strongly recommended when deployed.
DASHBOARD_PASSWORD=
